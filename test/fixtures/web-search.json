{
  "tools": [
    {
      "type": "function",
      "name": "exec_command",
      "description": "Run a command",
      "parameters": {
        "type": "object",
        "properties": { "cmd": { "type": "string" } }
      }
    },
    {
      "type": "web_search",
      "external_web_access": true,
      "search_context_size": "high",
      "user_location": { "type": "approximate", "country": "US", "city": "Seattle" },
      "description": "Search the web",
      "parameters": {
        "type": "object",
        "properties": { "query": { "type": "string" } },
        "required": ["query"]
      },
      "filters": {
        "excluded_domains": ["spam.test"],
        "allowed_domains": ["example.com"]
      },
      "allowed_domains": ["docs.example.com", "example.com"]
    },
    {
      "type": "custom",
      "name": "apply_patch",
      "description": "Patch files"
    },
    {
      "type": "web_search",
      "external_web_access": false,
      "filters": { "allowed_domains": ["ignored.example"] },
      "allowed_domains": ["ignored.example"]
    }
  ],
  "expected": {
    "allowed_domains": ["docs.example.com", "example.com"],
    "filters": {
      "allowed_domains": ["example.com"],
      "excluded_domains": ["spam.test"]
    },
    "type": "web_search"
  },
  "outputItem": {
    "type": "web_search_call",
    "id": "ws_1",
    "status": "completed",
    "action": {
      "type": "search",
      "query": "weather seattle",
      "sources": [{ "type": "url", "url": "https://example.com/weather" }]
    }
  }
}
